---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import type { CollectionEntry } from "astro:content";
import { getOrderedProjects } from "../../../lib/projects";
import { buildPagination } from "../../../lib/pagination";

export async function getStaticPaths() {
  const pageSize = 9;
  const allProjects = await getOrderedProjects();
  const { totalPages, pages } = buildPagination(allProjects, pageSize);
  const paths = [];

  for (let page = 2; page <= totalPages; page++) {
    paths.push({
      params: { page: String(page) },
      props: {
        projects: pages[page - 1].items,
        page,
        totalPages
      }
    });
  }

  return paths;
}

const { projects, page, totalPages }: { projects: CollectionEntry<"projects">[]; page: number; totalPages: number } = Astro.props;

const projectRows: CollectionEntry<"projects">[][] = [];
for (let i = 0; i < projects.length; i += 3) {
  projectRows.push(projects.slice(i, i + 3));
}
---

<BaseLayout title={`Projects - Page ${page} | Zerebos`} description="Browse projects from Zerebos.">
  <PageHeader title="Projects" blurb="Browse these projects to learn more about my previous work." />

  <section class="flex container column half-padded" id="projects">
    {
      projectRows.map((row) => (
        <div class="flex container project-row">
          {row.map((project) => (
            <div class="flex project">
              <a href={`/projects/${project.id}`} class="flex column gradient">
                {project.data.icon && (
                  <img src={`/assets/projects/icons/${project.data.icon}`} class="icon" alt={project.data.title} />
                )}
                <div class="flex column info">
                  <h3>{project.data.title}</h3>
                  <p>{project.data.blurb}</p>
                </div>
              </a>
            </div>
          ))}
        </div>
      ))
    }
  </section>

  <nav class="flex no-wrap paginator hybrid" role="navigation" aria-label="Pagination Navigation">
    <a href={page === 2 ? "/projects" : `/projects/page/${page - 1}`} class="gradient">‹ Prev</a>
    <ul class="page-numbers">
      <li><a href="/projects" class={`gradient ${page === 1 ? "active" : ""}`}>1</a></li>
      {
        Array.from({ length: totalPages - 1 }, (_, i) => i + 2).map((pageNumber) => (
          <li>
            <a href={`/projects/page/${pageNumber}`} class={`gradient ${page === pageNumber ? "active" : ""}`}>
              {pageNumber}
            </a>
          </li>
        ))
      }
    </ul>
    <a href={page < totalPages ? `/projects/page/${page + 1}` : undefined} class={`gradient ${page >= totalPages ? "disabled" : ""}`} aria-disabled={page >= totalPages}>
      Next ›
    </a>
  </nav>
</BaseLayout>
