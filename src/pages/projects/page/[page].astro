---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import { getOrderedProjects } from "../../../lib/projects";
import { PROJECTS_PAGE_SIZE } from "../../../lib/config";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const pageSize = PROJECTS_PAGE_SIZE;
  const allProjects = await getOrderedProjects();

  return paginate(allProjects, { pageSize })
    .filter((path) => path.params.page !== "1");
};

interface Props {
  page: Page<CollectionEntry<"projects">>;
}

const { page }: Props = Astro.props;
const projects = page.data;
const currentPage = page.currentPage;
const totalPages = page.lastPage;

const projectRows: CollectionEntry<"projects">[][] = [];
for (let i = 0; i < projects.length; i += 3) {
  projectRows.push(projects.slice(i, i + 3));
}
---

<BaseLayout title={`Projects - Page ${currentPage} | Zerebos`} description="Browse projects from Zerebos.">
  <PageHeader title="Projects" blurb="Browse these projects to learn more about my previous work." />

  <section class="flex container column half-padded" id="projects">
    {
      projectRows.map((row) => (
        <div class="flex container project-row">
          {row.map((project) => (
            <div class="flex project">
              <a href={`/projects/${project.id}`} class="flex column gradient">
                {project.data.icon && (
                  <Image
                    src={project.data.icon}
                    class="icon"
                    alt={project.data.title}
                    widths={[64, 128]}
                    sizes="(max-width: 768px) 48px, 64px"
                  />
                )}
                <div class="flex column info">
                  <h3>{project.data.title}</h3>
                  <p>{project.data.blurb}</p>
                </div>
              </a>
            </div>
          ))}
        </div>
      ))
    }
  </section>

  <nav class="flex no-wrap paginator hybrid" role="navigation" aria-label="Pagination Navigation">
    <a href={currentPage === 2 ? "/projects" : `/projects/page/${currentPage - 1}`} class="gradient">‹ Prev</a>
    <ul class="page-numbers">
      <li><a href="/projects" class={`gradient ${currentPage === 1 ? "active" : ""}`}>1</a></li>
      {
        Array.from({ length: totalPages - 1 }, (_, i) => i + 2).map((pageNumber) => (
          <li>
            <a href={`/projects/page/${pageNumber}`} class={`gradient ${currentPage === pageNumber ? "active" : ""}`}>
              {pageNumber}
            </a>
          </li>
        ))
      }
    </ul>
    <a href={currentPage < totalPages ? `/projects/page/${currentPage + 1}` : undefined} class={`gradient ${currentPage >= totalPages ? "disabled" : ""}`} aria-disabled={currentPage >= totalPages}>
      Next ›
    </a>
  </nav>
</BaseLayout>
