---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import PageHeader from "../../components/PageHeader.astro";

import type { CollectionEntry } from "astro:content";
import { getOrderedProjects } from "../../lib/projects";
import { PROJECTS_PAGE_SIZE, PROJECTS_DESCRIPTION } from "../../lib/config";

const pageSize = PROJECTS_PAGE_SIZE;
const allProjects: CollectionEntry<"projects">[] = await getOrderedProjects();
const totalPages = Math.max(1, Math.ceil(allProjects.length / pageSize));
const projects = allProjects.slice(0, pageSize);

const projectRows: CollectionEntry<"projects">[][] = [];
for (let i = 0; i < projects.length; i += 3) {
  projectRows.push(projects.slice(i, i + 3));
}
---

<BaseLayout title="Projects" description={PROJECTS_DESCRIPTION}>
  <PageHeader title="Projects" blurb={PROJECTS_DESCRIPTION} />

  <section class="flex container column half-padded" id="projects">
    {
      projectRows.map((row) => (
        <div class="flex container project-row">
          {row.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      ))
    }
  </section>

  {
    totalPages > 1 && (
      <nav class="flex no-wrap paginator hybrid" role="navigation" aria-label="Pagination Navigation">
        <a aria-disabled="true" class="hover-fill disabled">‹ Prev</a>
        <ul class="page-numbers">
          <li><a class="hover-fill active">1</a></li>
          {Array.from({ length: totalPages - 1 }, (_, i) => i + 2).map((page) => (
            <li><a href={`/projects/page/${page}`} class="hover-fill">{page}</a></li>
          ))}
        </ul>
        <a href="/projects/page/2" class="hover-fill">Next ›</a>
      </nav>
    )
  }
</BaseLayout>
