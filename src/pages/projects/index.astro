---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { Image } from "astro:assets";

import type { CollectionEntry } from "astro:content";
import { getOrderedProjects } from "../../lib/projects";
import { buildPagination } from "../../lib/pagination";

const pageSize = 9;
const allProjects: CollectionEntry<"projects">[] = await getOrderedProjects();
const { totalPages, pages } = buildPagination(allProjects, pageSize);
const projects = pages[0].items;

const projectRows: CollectionEntry<"projects">[][] = [];
for (let i = 0; i < projects.length; i += 3) {
  projectRows.push(projects.slice(i, i + 3));
}
---

<BaseLayout title="Projects | Zerebos" description="Browse projects from Zerebos.">
  <PageHeader title="Projects" blurb="Browse these projects to learn more about my previous work." />

  <section class="flex container column half-padded" id="projects">
    {
      projectRows.map((row) => (
        <div class="flex container project-row">
          {row.map((project) => (
            <div class="flex project">
              <a href={`/projects/${project.id}`} class="flex column gradient">
                {project.data.icon && (
                  <Image
                    src={project.data.icon}
                    class="icon"
                    alt={project.data.title}
                    widths={[128, 256]}
                    sizes="(max-width: 768px) 128px, 256px"
                  />
                )}
                <div class="flex column info">
                  <h3>{project.data.title}</h3>
                  <p>{project.data.blurb}</p>
                </div>
              </a>
            </div>
          ))}
        </div>
      ))
    }
  </section>

  {
    totalPages > 1 && (
      <nav class="flex no-wrap paginator hybrid" role="navigation" aria-label="Pagination Navigation">
        <a aria-disabled="true" class="gradient disabled">‹ Prev</a>
        <ul class="page-numbers">
          <li><a class="gradient active">1</a></li>
          {Array.from({ length: totalPages - 1 }, (_, i) => i + 2).map((page) => (
            <li><a href={`/projects/page/${page}`} class="gradient">{page}</a></li>
          ))}
        </ul>
        <a href="/projects/page/2" class="gradient">Next ›</a>
      </nav>
    )
  }
</BaseLayout>
