---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectHeader from "../../components/ProjectHeader.astro";
import ContentsBox from "../../components/ContentsBox.astro";
import RepositoryCard from "../../components/RepositoryCard.astro";
import { Image } from "astro:assets";
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { getGitHubData } from "../../lib/github";
import { GITHUB_USERNAME } from "../../lib/config";
import { getOrderedProjects } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getOrderedProjects();
  return projects.map((project: CollectionEntry<"projects">) => ({
    params: { slug: project.id },
    props: { project }
  }));
}

const { project }: { project: CollectionEntry<"projects"> } = Astro.props;
const { Content, headings } = await render(project);

const repo = project.data.repo;
let git = null;
let langs: Record<string, number> | null = null;
let branches: string[] | null = null;

if (repo) {
  const fullName = repo.includes("/") ? repo : `${GITHUB_USERNAME}/${repo}`;
  const github = await getGitHubData();
  git = github.projects.find(p => p.full_name === fullName) ?? null;
  langs = github.languages[fullName] ?? null;
  branches = github.branches[fullName] ?? null;
}
---

<BaseLayout title={`${project.data.title} - Project`} description={project.data.blurb} ogImage={project.data.banner} size="large">
  <article class="flex column post-page">
    <ProjectHeader project={project} />

    {project.data.banner && (
      <div class="project-banner">
        <Image
          src={project.data.banner}
          alt={project.data.title}
          widths={[640, 980, 1280]}
          sizes="(max-width: 1012px) 92vw, 980px"
        />
      </div>
    )}

    <div class="post-layout">
      <aside class="flex column post-side">
        {git && <RepositoryCard git={git} languages={langs} branches={branches} />}
        <ContentsBox label="On this page" headings={headings} />
      </aside>
      <section class="project-markdown post-body">
        <div class="content">
          <Content />
        </div>
      </section>
    </div>
  </article>
</BaseLayout>
