---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPostPreview from "../components/BlogPostPreview.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { getGitHubData } from "../lib/github";
import { getOrderedProjects } from "../lib/projects";

const allProjects: CollectionEntry<"projects">[] = await getOrderedProjects();
const featuredProjects = allProjects.slice(0, 6);
const featuredRows: CollectionEntry<"projects">[][] = [];
for (let i = 0; i < featuredProjects.length; i += 3) {
  featuredRows.push(featuredProjects.slice(i, i + 3));
}

const allPosts: CollectionEntry<"blog">[] = await getCollection("blog");
const latestPosts = allPosts
  .sort((a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const github = await getGitHubData();
const marqueeStats = Object.entries(github.stats);
---

<BaseLayout title="Zerebos" description="Landing page and portfolio for Zerebos">
  <section class="flex container column" id="intro">
    <div class="flex avatar-container">
      <img src="/assets/images/avatar.webp" class="intro-avatar" alt="Picture of me" />
      <div class="flex column">
        <h1>Zerebos</h1>
        <p>Engineer, Creator, Educator</p>
      </div>
    </div>
    <div class="flex column blurb">
      <p>
        A programmer with a mind that never stops ticking. Never sticks to just one language, use the
        right tools for the job. Works on multiple <strong>open-source</strong> projects. Always looks
        to do more for the developer community.
      </p>
    </div>
    <div class="flex column profile">
      <p>
        Keeping systems running <span>@IBM</span> System Z
      </p>
    </div>
  </section>

  <section class="flex" id="marquee">
    <div class="flex">
      {marqueeStats.map(([label, value]) => (
        <div class="stat">
          <div class="label">{label}</div>
          <div class="value">{(value as number).toLocaleString()}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="flex container column half-padded showcase" id="projects">
    <div class="flex container heading">
      <h2>Featured Projects</h2>
      <a href="/projects">All Projects ▸</a>
    </div>
    {
      featuredProjects.length > 0 ? (
        featuredRows.map((row) => (
          <div class="flex container project-row">
            {row.map((project) => (
              <div class="flex project">
                <a href={`/projects/${project.id}`} class="flex column gradient">
                  {project.data.icon && (
                    <img
                      src={`/assets/projects/icons/${project.data.icon}`}
                      class="icon"
                      alt={project.data.title}
                    />
                  )}
                  <div class="flex column info">
                    <h3>{project.data.title}</h3>
                    <p>{project.data.blurb}</p>
                  </div>
                </a>
              </div>
            ))}
          </div>
        ))
      ) : (
        <div class="no-posts">
          <p>Projects coming soon.</p>
        </div>
      )
    }
  </section>

  <section class="flex container column half-padded showcase" id="latest-posts">
    <div class="flex container heading">
      <h2>Latest Posts</h2>
      <a href="/blog">All Posts ▸</a>
    </div>
    {
      latestPosts.length > 0 ? (
        latestPosts.map((post) => <BlogPostPreview post={post} />)
      ) : (
        <div class="no-posts">
          <p>Blog posts coming soon.</p>
        </div>
      )
    }
  </section>

  <section class="flex container half-padded" id="contact">
    <form action="https://api.staticforms.xyz/submit" method="post" id="contactform" class="flex">
      <div class="flex column left">
        <label for="name">Name</label>
        <input class="text-input" type="text" name="name" placeholder="John Smith" required />
        <label for="filter">Spam Filter</label>
        <input class="text-input" type="text" name="filter" placeholder="Spam Filter" required />
        <div id="captcha-wrap"><canvas id="captcha"></canvas></div>
        <label for="email">Email</label>
        <input class="text-input" type="email" name="email" placeholder="jsmith@bigcompany.com" required />
        <label for="subject">Subject</label>
        <input class="text-input" type="text" name="subject" placeholder="I want to hire you!" required />
        <button class="btn btn-primary" type="submit">Send Message</button>
      </div>
      <div class="flex column right">
        <label for="message">Message</label>
        <textarea class="text-input" name="message" cols="20" rows="7" placeholder="I have a great job opportunity for you..." required></textarea>
      </div>
    </form>
  </section>

  <script src="../scripts/contact.ts"></script>
  <script src="../scripts/marquee.ts"></script>
</BaseLayout>
