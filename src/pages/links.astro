---
import BaseLayout from "../layouts/BaseLayout.astro";
import links from "../data/links.js";
import about from "../data/about.js";
---

<BaseLayout title="Links | Zerebos" description="Social links and project links for Zerebos">
  <div id="links-container">
    <section class="flex container column" id="links-header">
      <div class="flex column avatar-container">
        <img src="/assets/images/avatar.webp" class="intro-avatar" alt="Picture of me" />
        <div class="flex column">
          <h1>Zerebos</h1>
          <p>{about.title}</p>
        </div>
      </div>
      <div class="flex column blurb">
        <p>
          {about.current.map((item: string, i: number) => (
            <>
              {item}
              {i < about.current.length - 1 && <span> ✦ </span>}
            </>
          ))}
        </p>
      </div>
    </section>

    <section class="flex container" id="links-icons">
      {links.icons.map((icon: {icon: string; href: string}) => (
        <a href={icon.href} target="_blank" rel="noopener noreferrer" class="flex gradient">
          <img src={`/assets/icons/${icon.icon}.svg`} alt={icon.icon} />
        </a>
      ))}
    </section>

    {links.categories.map((category: {label: string; links: {href: string; icon: string; label: string}[]}) => (
      <section class="flex column container listbox">
        <div class="flex heading">
          <h2>{category.label}</h2>
        </div>
        <div class="flex column list">
          {category.links.map((link) => (
            <a class="flex link gradient outline" href={link.href} target="_blank" rel="noopener noreferrer">
              <div class="flex label">
                <img src={link.icon} alt={link.label} />
                <span>{link.label}</span>
              </div>
              <div class="flex external">
                <img src="/assets/icons/external-link.svg" alt="External link" />
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
