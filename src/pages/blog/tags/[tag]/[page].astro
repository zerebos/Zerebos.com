---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import BlogPostPreview from "../../../../components/BlogPostPreview.astro";
import TagsSection from "../../../../components/TagsSection.astro";
import PageHeader from "../../../../components/PageHeader.astro";
import { countLabel } from "../../../../lib/text";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import { getOrderedBlogPosts, getTagBlurb, getTagCounts, getTagPostGroups } from "../../../../lib/blog";
import { BLOG_PAGE_SIZE } from "../../../../lib/config";

type BlogEntry = CollectionEntry<"blog">;

interface Props {
  tagSlug: string;
  tagName: string;
  page: Page<BlogEntry>;
  totalPosts: number;
  tagCounts: ReturnType<typeof getTagCounts>;
}

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const pageSize = BLOG_PAGE_SIZE;

  const allPosts: BlogEntry[] = await getOrderedBlogPosts();
  const tagCounts = getTagCounts(allPosts);

  const paths = [];

  for (const { tagSlug, tagName, posts, totalPosts } of getTagPostGroups(allPosts)) {
    const tagPaths = paginate(posts, {
      pageSize,
      params: { tag: tagSlug },
      props: {
        tagSlug,
        tagName,
        totalPosts,
        tagCounts
      }
    }).filter((path) => path.params.page !== "1");

    paths.push(...tagPaths);
  }

  return paths;
};

const { tagSlug, tagName, page, totalPosts, tagCounts }: Props = Astro.props;
const posts = page.data;
const currentPage = page.currentPage;
const totalPages = page.lastPage;
const tagBlurb = getTagBlurb(totalPosts);
---

<BaseLayout title={`Posts tagged "${tagName}" - Page ${currentPage}`} description={tagBlurb}>
  <PageHeader title={tagName} crumb={{ label: "Blog", href: "/blog" }}>
    {countLabel(totalPosts, "post")}{totalPages > 1 && ` · Page ${currentPage} of ${totalPages}`}
  </PageHeader>

  <section class="flex column container" id="blog-posts">
    {posts.map((post) => <BlogPostPreview post={post} />)}
  </section>

  <nav class="flex no-wrap paginator hybrid" role="navigation" aria-label="Pagination Navigation">
    <a href={currentPage === 2 ? `/blog/tags/${tagSlug}` : `/blog/tags/${tagSlug}/${currentPage - 1}`} class="hover-fill">‹ Prev</a>
    <ul class="page-numbers">
      <li><a href={`/blog/tags/${tagSlug}`} class={`hover-fill ${currentPage === 1 ? "active" : ""}`}>1</a></li>
      {
        Array.from({ length: totalPages - 1 }, (_, i) => i + 2).map((pageNumber) => (
          <li>
            <a href={`/blog/tags/${tagSlug}/${pageNumber}`} class={`hover-fill ${currentPage === pageNumber ? "active" : ""}`}>
              {pageNumber}
            </a>
          </li>
        ))
      }
    </ul>
    <a href={currentPage < totalPages ? `/blog/tags/${tagSlug}/${currentPage + 1}` : undefined} class={`hover-fill ${currentPage >= totalPages ? "disabled" : ""}`} aria-disabled={currentPage >= totalPages}>
      Next ›
    </a>
  </nav>

  <TagsSection tagCounts={tagCounts} />
</BaseLayout>
