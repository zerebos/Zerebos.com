---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import BlogPostPreview from "../../../../components/BlogPostPreview.astro";
import TagList from "../../../../components/TagList.astro";
import PageHeader from "../../../../components/PageHeader.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { buildTagPagination, getOrderedTags, getTagBlurb, getTagCounts } from "../../../../lib/blog";

type BlogEntry = CollectionEntry<"blog">;

interface Props {
  tagSlug: string;
  tagName: string;
  posts: BlogEntry[];
  page: number;
  totalPages: number;
  totalPosts: number;
  tagCounts: ReturnType<typeof getTagCounts>;
}

export async function getStaticPaths() {
  const pageSize = 3;

  const allPosts: BlogEntry[] = (await getCollection("blog")).sort(
    (a: BlogEntry, b: BlogEntry) => b.data.date.getTime() - a.data.date.getTime()
  );
  const tagCounts = getTagCounts(allPosts);

  const paths = [];

  for (const { tagSlug, tagName, pages, totalPages, totalPosts } of buildTagPagination(allPosts, pageSize)) {
    for (let page = 2; page <= totalPages; page++) {
      paths.push({
        params: { tag: tagSlug, page: String(page) },
        props: {
          tagSlug,
          tagName,
          posts: pages[page - 1].items,
          page,
          totalPages,
          totalPosts,
          tagCounts
        }
      });
    }
  }

  return paths;
}

const { tagSlug, tagName, posts, page, totalPages, totalPosts, tagCounts }: Props = Astro.props;
const tagBlurb = getTagBlurb(totalPosts);
---

<BaseLayout title={`${tagName} - Page ${page} | Zerebos Blog`} description={tagBlurb}>
  <PageHeader title={tagName} blurb={tagBlurb} />

  <section class="flex column container" id="blog-posts">
    {posts.map((post) => <BlogPostPreview post={post} />)}
  </section>

  <nav class="flex no-wrap paginator hybrid" role="navigation" aria-label="Pagination Navigation">
    <a href={page === 2 ? `/blog/tags/${tagSlug}` : `/blog/tags/${tagSlug}/${page - 1}`} class="gradient">‹ Prev</a>
    <ul class="page-numbers">
      <li><a href={`/blog/tags/${tagSlug}`} class={`gradient ${page === 1 ? "active" : ""}`}>1</a></li>
      {
        Array.from({ length: totalPages - 1 }, (_, i) => i + 2).map((pageNumber) => (
          <li>
            <a href={`/blog/tags/${tagSlug}/${pageNumber}`} class={`gradient ${page === pageNumber ? "active" : ""}`}>
              {pageNumber}
            </a>
          </li>
        ))
      }
    </ul>
    <a href={page < totalPages ? `/blog/tags/${tagSlug}/${page + 1}` : undefined} class={`gradient ${page >= totalPages ? "disabled" : ""}`} aria-disabled={page >= totalPages}>
      Next ›
    </a>
  </nav>

  <hr class="flex container medium" />

  <section class="flex column flex-align-center container" id="blog-tags">
    <TagList tags={getOrderedTags(tagCounts).map(([tag]) => tag)} tagCounts={tagCounts} wrapperClass="tag-cloud" />
  </section>
</BaseLayout>
