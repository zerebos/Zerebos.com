---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPostPreview from "../../components/BlogPostPreview.astro";
import TagList from "../../components/TagList.astro";
import PageHeader from "../../components/PageHeader.astro";
import FeedLink from "../../components/FeedLink.astro";
import { countLabel } from "../../lib/text";

import type { CollectionEntry } from "astro:content";
import { getOrderedBlogPosts, getOrderedTags, getTagCounts } from "../../lib/blog";
import { BLOG_PAGE_SIZE, BLOG_DESCRIPTION } from "../../lib/config";

const pageSize = BLOG_PAGE_SIZE;
const allPosts: CollectionEntry<"blog">[] = await getOrderedBlogPosts();
const totalPages = Math.max(1, Math.ceil(allPosts.length / pageSize));
const posts = allPosts.slice(0, pageSize);

const tagCounts = getTagCounts(allPosts);
---

<BaseLayout title="Blog" description={BLOG_DESCRIPTION}>
  <PageHeader title="Blog" blurb={BLOG_DESCRIPTION}>
    {countLabel(allPosts.length, "post")} · <FeedLink />{totalPages > 1 && ` · Page 1 of ${totalPages}`}
  </PageHeader>

  <section class="flex column container" id="blog-posts">
    {posts.map((post) => <BlogPostPreview post={post} />)}
  </section>

  {
    totalPages > 1 && (
      <nav class="flex no-wrap paginator hybrid" role="navigation" aria-label="Pagination Navigation">
        <a aria-disabled="true" class="hover-fill disabled">‹ Prev</a>
        <ul class="page-numbers">
          <li><a class="hover-fill active">1</a></li>
          {Array.from({ length: totalPages - 1 }, (_, i) => i + 2).map((page) => (
            <li><a href={`/blog/page/${page}`} class="hover-fill">{page}</a></li>
          ))}
        </ul>
        <a href="/blog/page/2" class="hover-fill">Next ›</a>
      </nav>
    )
  }

  <hr class="flex container medium" />

  <section class="flex column flex-align-center container" id="blog-tags">
    <TagList tags={getOrderedTags(tagCounts).map(([tag]) => tag)} tagCounts={tagCounts} wrapperClass="tag-cloud" />
  </section>
</BaseLayout>
