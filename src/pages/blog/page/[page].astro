---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogPostPreview from "../../../components/BlogPostPreview.astro";
import TagsSection from "../../../components/TagsSection.astro";
import PageHeader from "../../../components/PageHeader.astro";
import FeedLink from "../../../components/FeedLink.astro";
import { countLabel } from "../../../lib/text";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import { getOrderedBlogPosts, getTagCounts } from "../../../lib/blog";
import { BLOG_PAGE_SIZE, BLOG_DESCRIPTION } from "../../../lib/config";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const pageSize = BLOG_PAGE_SIZE;
  const allPosts = await getOrderedBlogPosts();
  const tagCounts = getTagCounts(allPosts);

  return paginate(allPosts, { pageSize })
    .filter((path) => path.params.page !== "1")
    .map((path) => ({
      ...path,
      props: {
        ...path.props,
        tagCounts
      }
    }));
};

interface Props {
  page: Page<CollectionEntry<"blog">>;
  tagCounts: ReturnType<typeof getTagCounts>;
}

const { page, tagCounts }: Props = Astro.props;
const posts = page.data;
const currentPage = page.currentPage;
const totalPages = page.lastPage;
---

<BaseLayout title={`Blog - Page ${currentPage}`} description={BLOG_DESCRIPTION}>
  <PageHeader title="Blog" blurb={BLOG_DESCRIPTION}>
    {countLabel(page.total, "post")} · <FeedLink />{totalPages > 1 && ` · Page ${currentPage} of ${totalPages}`}
  </PageHeader>

  <section class="flex column container" id="blog-posts">
    {posts.map((post) => <BlogPostPreview post={post} />)}
  </section>

  <nav class="flex no-wrap paginator hybrid" role="navigation" aria-label="Pagination Navigation">
    <a href={currentPage === 2 ? "/blog" : `/blog/page/${currentPage - 1}`} class="hover-fill">‹ Prev</a>
    <ul class="page-numbers">
      <li><a href="/blog" class={`hover-fill ${currentPage === 1 ? "active" : ""}`}>1</a></li>
      {
        Array.from({ length: totalPages - 1 }, (_, i) => i + 2).map((pageNumber) => (
          <li>
            <a href={`/blog/page/${pageNumber}`} class={`hover-fill ${currentPage === pageNumber ? "active" : ""}`}>
              {pageNumber}
            </a>
          </li>
        ))
      }
    </ul>
    <a href={currentPage < totalPages ? `/blog/page/${currentPage + 1}` : undefined} class={`hover-fill ${currentPage >= totalPages ? "disabled" : ""}`} aria-disabled={currentPage >= totalPages}>
      Next ›
    </a>
  </nav>

  <TagsSection tagCounts={tagCounts} />
</BaseLayout>
