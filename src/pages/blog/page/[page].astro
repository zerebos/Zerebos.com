---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogPostPreview from "../../../components/BlogPostPreview.astro";
import TagList from "../../../components/TagList.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import { getOrderedTags, getTagCounts } from "../../../lib/blog";
import { BLOG_PAGE_SIZE, BLOG_DESCRIPTION } from "../../../lib/config";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const pageSize = BLOG_PAGE_SIZE;
  const allPosts = (await getCollection("blog")).sort(
    (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) => b.data.date.getTime() - a.data.date.getTime()
  );
  const tagCounts = getTagCounts(allPosts);

  return paginate(allPosts, { pageSize })
    .filter((path) => path.params.page !== "1")
    .map((path) => ({
      ...path,
      props: {
        ...path.props,
        tagCounts
      }
    }));
};

interface Props {
  page: Page<CollectionEntry<"blog">>;
  tagCounts: ReturnType<typeof getTagCounts>;
}

const { page, tagCounts }: Props = Astro.props;
const posts = page.data;
const currentPage = page.currentPage;
const totalPages = page.lastPage;
---

<BaseLayout title={`Blog - Page ${currentPage}`} description={BLOG_DESCRIPTION}>
  <PageHeader title="Blog" blurb={BLOG_DESCRIPTION} />

  <section class="flex column container" id="blog-posts">
    {posts.map((post) => <BlogPostPreview post={post} />)}
  </section>

  <nav class="flex no-wrap paginator hybrid" role="navigation" aria-label="Pagination Navigation">
    <a href={currentPage === 2 ? "/blog" : `/blog/page/${currentPage - 1}`} class="gradient">‹ Prev</a>
    <ul class="page-numbers">
      <li><a href="/blog" class={`gradient ${currentPage === 1 ? "active" : ""}`}>1</a></li>
      {
        Array.from({ length: totalPages - 1 }, (_, i) => i + 2).map((pageNumber) => (
          <li>
            <a href={`/blog/page/${pageNumber}`} class={`gradient ${currentPage === pageNumber ? "active" : ""}`}>
              {pageNumber}
            </a>
          </li>
        ))
      }
    </ul>
    <a href={currentPage < totalPages ? `/blog/page/${currentPage + 1}` : undefined} class={`gradient ${currentPage >= totalPages ? "disabled" : ""}`} aria-disabled={currentPage >= totalPages}>
      Next ›
    </a>
  </nav>

  <hr class="flex container medium" />

  <section class="flex column flex-align-center container" id="blog-tags">
    <TagList tags={getOrderedTags(tagCounts).map(([tag]) => tag)} tagCounts={tagCounts} wrapperClass="tag-cloud" />
  </section>
</BaseLayout>
