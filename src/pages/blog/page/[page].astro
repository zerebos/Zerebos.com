---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogPostPreview from "../../../components/BlogPostPreview.astro";
import TagList from "../../../components/TagList.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { getOrderedTags, getTagCounts } from "../../../lib/blog";

export async function getStaticPaths() {
  const pageSize = 3;
  const allPosts = (await getCollection("blog")).sort(
    (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) => b.data.date.getTime() - a.data.date.getTime()
  );
  const tagCounts = getTagCounts(allPosts);

  const totalPages = Math.ceil(allPosts.length / pageSize);
  const paths = [];

  for (let page = 2; page <= totalPages; page++) {
    const start = (page - 1) * pageSize;
    const end = start + pageSize;
    paths.push({
      params: { page: String(page) },
      props: {
        posts: allPosts.slice(start, end),
        page,
        totalPages,
        tagCounts
      }
    });
  }

  return paths;
}

const { posts, page, totalPages, tagCounts }: { posts: CollectionEntry<"blog">[]; page: number; totalPages: number; tagCounts: ReturnType<typeof getTagCounts> } = Astro.props;
---

<BaseLayout title={`Blog - Page ${page} | Zerebos`} description="Development insights, tutorials, and thoughts on open source.">
  <PageHeader title="Blog" blurb="Development insights, tutorials, and thoughts on open source." />

  <section class="flex column container" id="blog-posts">
    {posts.map((post) => <BlogPostPreview post={post} />)}
  </section>

  <nav class="flex no-wrap paginator hybrid" role="navigation" aria-label="Pagination Navigation">
    <a href={page === 2 ? "/blog/" : `/blog/page/${page - 1}/`} class="gradient">‹ Prev</a>
    <ul class="page-numbers">
      <li><a href="/blog/" class={`gradient ${page === 1 ? "active" : ""}`}>1</a></li>
      {
        Array.from({ length: totalPages - 1 }, (_, i) => i + 2).map((pageNumber) => (
          <li>
            <a href={`/blog/page/${pageNumber}/`} class={`gradient ${page === pageNumber ? "active" : ""}`}>
              {pageNumber}
            </a>
          </li>
        ))
      }
    </ul>
    <a href={page < totalPages ? `/blog/page/${page + 1}/` : undefined} class={`gradient ${page >= totalPages ? "disabled" : ""}`} aria-disabled={page >= totalPages}>
      Next ›
    </a>
  </nav>

  <hr class="flex container medium" />

  <section class="flex column flex-align-center container" id="blog-tags">
    <TagList tags={getOrderedTags(tagCounts).map(([tag]) => tag)} tagCounts={tagCounts} wrapperClass="tag-cloud" />
  </section>
</BaseLayout>
