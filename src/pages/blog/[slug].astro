---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostHeader from "../../components/PostHeader.astro";
import TagList from "../../components/TagList.astro";
import ContentsBox from "../../components/ContentsBox.astro";
import { Image } from "astro:assets";
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { getBlogPosts, getTagCounts, readingTime } from "../../lib/blog";
import { linkedinIcon, twitterIcon } from "../../lib/icons";
import { SITE_URL, PSEUDONYM } from "../../lib/config";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  const tagCounts = getTagCounts(posts);
  return posts.map((post: CollectionEntry<"blog">) => ({
    params: { slug: post.id },
    props: { post, tagCounts }
  }));
}

const { post }: { post: CollectionEntry<"blog"> } = Astro.props;
const { Content, headings } = await render(post);
const canonical = new URL(`/blog/${post.id}`, Astro.site ?? SITE_URL).toString();
---

<BaseLayout
  title={post.data.title}
  description={post.data.blurb}
  ogType="article"
  publishedTime={post.data.date}
  ogImage={post.data.banner}
  author={PSEUDONYM}
  size="large"
>
  <article class="flex column post-page">
    <PostHeader
      title={post.data.title}
      blurb={post.data.blurb}
      date={post.data.date}
      updated={post.data.updated}
      readingTime={readingTime(post.body!)}
      primaryTag={post.data.primaryTag}
      titleTransitionName={`post-title-${post.id}`}
    />

    {post.data.banner && (
      <Image
        src={post.data.banner}
        class="post-banner"
        alt={post.data.title}
        widths={[640, 980, 1280, 1960]}
        sizes="(max-width: 1012px) 92vw, 980px"
      />
    )}

    <div class="post-layout">
      <aside class="flex column post-side">
        <ContentsBox label="In this post" headings={headings} />
      </aside>
      <section class="project-markdown post-body">
        <div class="content">
          <Content />
        </div>
      </section>
    </div>

    <footer class="flex post-footer">
      <TagList tags={post.data.tags ?? []} wrapperClass="flex post-tags" />

      <div class="flex post-share">
        <span class="share-label">Share</span>
        <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(canonical)}&text=${encodeURIComponent(post.data.title)}`} target="_blank" rel="noopener noreferrer">
          <Image src={twitterIcon} alt="Share on X" width={20} height={20} />
        </a>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical)}`} target="_blank" rel="noopener noreferrer">
          <Image src={linkedinIcon} alt="Share on LinkedIn" width={20} height={20} />
        </a>
      </div>
    </footer>
  </article>

  <script src="../../scripts/aside.ts"></script>
</BaseLayout>
