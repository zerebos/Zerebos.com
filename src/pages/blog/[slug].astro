---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import TagList from "../../components/TagList.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { getTagCounts } from "../../lib/blog";
import { linkedinIcon, twitterIcon } from "../../lib/icons";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const tagCounts = getTagCounts(posts);
  return posts.map((post: CollectionEntry<"blog">) => ({
    params: { slug: post.id },
    props: { post, tagCounts }
  }));
}

const { post, tagCounts }: { post: CollectionEntry<"blog">; tagCounts: ReturnType<typeof getTagCounts> } = Astro.props;
const { Content } = await render(post);
const canonical = new URL(`/blog/${post.id}`, Astro.site ?? "https://zerebos.com").toString();
---

<BaseLayout
  title={`${post.data.title} | Zerebos`}
  description={post.data.blurb}
  ogType="article"
  publishedTime={post.data.date}
  ogImage={post.data.banner}
  author="Zerebos"
>
  <PageHeader title={post.data.title} date={post.data.date} blurb={post.data.blurb} />

  {post.data.banner && (
    <section class="flex column flex-align-center banner">
      <Image
        src={post.data.banner}
        alt={post.data.title}
        widths={[640, 960, 1280]}
        sizes="(max-width: 768px) 92vw, 960px"
      />
    </section>
  )}

  <section class="flex column container blog-content project-markdown">
    <div class="flex column content">
      <Content />
    </div>
  </section>

  <section class="flex container blog-navigation">
    <TagList tags={post.data.blogTags ?? []} tagCounts={tagCounts} />

    <div class="flex column blog-share">
      <span>Share this post:</span>
      <div class="flex share-links" id="links-icons">
        <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(canonical)}&text=${encodeURIComponent(post.data.title)}`} target="_blank" rel="noopener noreferrer">
          <Image src={twitterIcon} alt="Share on X" width={24} height={24} />
        </a>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical)}`} target="_blank" rel="noopener noreferrer">
          <Image src={linkedinIcon} alt="Share on LinkedIn" width={24} height={24} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
