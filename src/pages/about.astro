---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { Image } from "astro:assets";
import { getEntry, render } from "astro:content";

const page = await getEntry("pages", "about");
if (!page) throw new Error("src/content/pages/about.md is missing");
const { title, blurb, updated, banner, bannerAlt, bannerCaption } = page.data;
const { Content } = await render(page);
---

<BaseLayout title="About" description="About Zerebos" ogImage={banner}>
  <article class="flex column detail-page" id="about">
    <PageHeader title={title} blurb={blurb}>
      {updated && (
        <>
          {/* the date has no time, so it's read as UTC midnight and shown in UTC to stay on the same day */}
          Updated <time datetime={updated.toISOString().slice(0, 10)}>{updated.toLocaleDateString("en-US", { dateStyle: "medium", timeZone: "UTC" })}</time>
        </>
      )}
    </PageHeader>

    {banner && (
      <figure class="flex column about-banner">
        <Image src={banner} class="post-banner" alt={bannerAlt ?? ""} widths={[640, 960, 1416]} sizes="(max-width: 708px) 92vw, 708px" />
        {bannerCaption && <figcaption class="text-muted">{bannerCaption}</figcaption>}
      </figure>
    )}

    <section class="markdown detail-body">
      <div class="content">
        <Content />
      </div>
    </section>
  </article>
</BaseLayout>
