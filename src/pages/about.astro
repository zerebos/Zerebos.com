---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import about from "../data/about";
---

<BaseLayout title="About | Zerebos" description="About Zerebos">
  <PageHeader title="About Me" blurb="For those that want to know a little more." />

  <div class="flex column" id="about">
    <section class="flex column flex-align-center banner">
      <img src={about.banner.url} alt="Hardware Project" />
      <p class="caption">{about.banner.caption}</p>
    </section>

    {about.sections.map((section: {title: string; content: string}) => (
      <section class="flex column paragraph container medium">
        <div class="flex heading">
          <h2>{section.title}</h2>
        </div>
        <p set:html={section.content}></p>
      </section>
    ))}
  </div>
</BaseLayout>
