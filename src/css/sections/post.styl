/* Blog Tags Styles */
.tag {
    width: auto;
    border: 1px solid rgba(82, 82, 82, 0.5);
    display: inline-block;
    padding: 4px 8px;
    margin: 2px;
    background: none;
    color: white;
    text-decoration: none;
    border-radius: 12px;
    font-size: 0.85em;
    font-weight: 500;
    /* transition: none; */
    transition: background-color 0.2s ease;
}

.tag:hover {
    background: var(--accent-color);
    color: white;
}

.tag.current {
    background: var(--accent-color);
}

.tag .count {
    margin-left: 4px;
    opacity: 0.7;
    font-size: 0.9em;
    font-weight: normal;
}

.tag-cloud {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 1rem;
}

.tag-count {
    color: var(--text-primary);
    font-weight: normal;
    font-size: 0.9em;
}

.blog-post-preview {
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    gap: 1rem;
}

.blog-post-preview:last-child {
    border-bottom: none;
}

.blog-post-preview h2 {
    margin: 0 0 0.5rem 0;
}

.blog-post-preview h2 a {
    color: var(--text-heading);
    text-decoration: none;
}

.blog-post-preview h2 a:hover {
    color: var(--accent-color);
}

// .blog-preview-thumbnail {
//     // max-width: 25%;
//     height: 100%;
// }

.blog-tags {
    max-width: 75%;
}

.post-description {
    color: var(--text-primary);
    margin: 0.75rem 0;
    line-height: 1.5;
}

.read-more {
    color: var(--accent-color);
    text-decoration: none;
    font-weight: 500;
}

.read-more:hover {
    color: var(--accent-color-hover);
}

.tag-section {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.tag-section:last-child {
    border-bottom: none;
}

.tag-section h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
}

.tag-section h2 a {
    color: var(--text-heading);
    text-decoration: none;
}

.tag-section h2 a:hover {
    color: var(--accent-color);
}

.tag-posts {
    display: grid;
    gap: 1rem;
}

.tag-post-preview h3 {
    margin: 0 0 0.25rem 0;
    font-size: 1.1em;
}

.tag-post-preview h3 a {
    color: var(--text-heading);
    text-decoration: none;
}

.tag-post-preview h3 a:hover {
    color: var(--accent-color);
}

.tag-post-preview time {
    font-size: 0.85em;
    color: var(--text-primary);
}

.tag-post-preview p {
    margin: 0.5rem 0 0 0;
    color: var(--text-primary);
    font-size: 0.95em;
}

.view-all {
    color: var(--accent-color);
    text-decoration: none;
    font-weight: 500;
    margin-top: 0.5rem;
    display: inline-block;
}

.view-all:hover {
    color: var(--accent-color-hover);
}

.blog-post-preview,
.blog-preview-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.blog-post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9em;
    color: var(--text-primary);
}


.blog-navigation {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1rem;
}

.blog-navigation > a {
    height: min-content
}

.blog-share {
    gap: 12px;
}

.share-links {
    justify-content: space-evenly;
}