.project-markdown img {
    border-radius: 10px;
    border: 1px solid black;
    align-self: center;
}

.project-markdown > img {
    margin-bottom: 20px;
}

.project-markdown hr {
    border: 0;
    height: 1px;
    width: 100%;
    background: rgba(255,255,255,0.2);
}

.project-markdown pre {
    overflow-x: auto;
    width: 100%;
    border-radius: 12px;
}

.project-markdown h1,
.project-markdown h2,
.project-markdown h3,
.project-markdown h4,
.project-markdown h5 {
    margin: 1rem 0 0 0;
    max-width: 100%;
}


.project-markdown a {
    text-decoration: dotted underline;
}

.project-markdown a:hover {
    text-decoration: solid underline;
}

.project-markdown strong {
    font-weight: 600;
    color: var(--text-heading);
}