.project-markdown {
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: unquote('hsl(from var(--text-primary) h s calc(l - 5))');
    padding: 0;
}

.project-markdown .content {
	margin-bottom: 40px;
    padding: 2rem;
    gap: 12px;
    background-color: var(--background-secondary);
    backdrop-filter: blur(12px);
    border-radius: 12px;
    border: 1px solid rgba(82, 82, 82, 0.2);
    flex: 1;
    width: 100%;
}

