.project-markdown h1,
.project-markdown h2,
.project-markdown h3,
.project-markdown h4,
.project-markdown h5 {
    color: rgba(114, 120, 136, 1.0); // #727888
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    border-bottom: 1px dotted rgb(114, 120, 136);
    padding-bottom: 6px;
}

.project-markdown h1 {
    font-size: 18px;
}

.project-markdown h2 {
    font-size: 16px;
}

.project-markdown h3 {
    font-size: 14px;
}

.project-markdown h4 {
    font-size: 12px;
}

.project-markdown h5 {
    font-size: 12px;
}

