{% extends "./basic.njk" %}

{% import "components/blog.njk" as blog %}

{% block content %}

{% if banner %}
<section class="flex column flex-align-center banner">
    <img src="{{banner}}" alt="{{title}}" />
</section>
{% endif %}

<section class="flex column container blog-content project-markdown">
    <div class="flex column content">
        {{content | safe}}
    </div>
</section>

<section class="flex container blog-navigation">
    {{ blog.tagList(blogTags, 0, collections) }}
    <div class="flex column blog-share">
        <span>Share this post:</span>
        <div class="flex share-links" id="links-icons">
            <a href="https://twitter.com/intent/tweet?url={{page.url | absolute}}&text={{title}}" target="_blank" rel="noopener noreferrer"><img src="/assets/icons/twitter.svg" /></a>
            <a href="https://www.linkedin.com/sharing/share-offsite/?url={{page.url | absolute}}" target="_blank" rel="noopener noreferrer"><img src="/assets/icons/linkedin.svg" /></a>
        </div>
    </div>
</section>

<link href="https://unpkg.com/prism-themes@1.9.0/themes/prism-vsc-dark-plus.css" rel="stylesheet" />
{% endblock %}