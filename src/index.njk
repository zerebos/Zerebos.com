---
layout: base.njk
---

<section class="flex container column" id="intro">
    <div class="flex avatar-container">
        <img src="assets/images/avatar.webp" class="intro-avatar" alt="Picture of me">
        <div class="flex column">
            <h1>Zerebos</h1>
            <p>{{about.title}}</p>
        </div>
    </div>
    <div class="flex column blurb">
        <p>{{about.blurb | safe}}</p>
    </div>
    <div class="flex column profile">
        <p>{{about.byline | safe}}</p>
    </div>
</section>


{% include "partials/marquee.njk" %}


<section class="flex container column half-padded showcase" id="projects">
    <div class="flex container heading">
        <h2>Featured Projects</h2>
        <a href="/projects">All Projects ▸</a>
    </div>
    {% for proj in collections.projects %}
        {% if (loop.index == 1) or (loop.index == 4) %}
            <div class="flex container project-row">
        {% endif %}
        <div class="flex project">
            <a href="{{proj.url}}" class="flex column gradient">
                <img src="assets/projects/icons/{{proj.data.icon}}" class="icon" alt="{{proj.data.title}}" />
                <div class="flex column info">
                    <h3>{{proj.data.title}}</h3>
                    <p>{{proj.data.blurb}}</p>
                </div>
            </a>
        </div>
        {% if (loop.index == 3) or (loop.index == 6) %}
            </div>
        {% endif %}
    {% endfor %}
</section>

{% import "components/blog.njk" as blog %}
<section class="flex container column half-padded showcase" id="latest-posts">
    <div class="flex container heading">
        <h2>Latest Posts</h2>
        <a href="/blog">All Posts ▸</a>
    </div>
    {% if collections.blog.length > 0 %}
        {% for post in collections.blog | reverse %}
            {% if loop.index <= 3 %}
                {{ blog.preview(post) }}
            {% endif %}
        {% endfor %}
    {% else %}
        <div class="no-posts">
            <p>Blog posts coming soon! I'll be sharing development insights, tutorials, and lessons learned from my open source projects.</p>
        </div>
    {% endif %}
</section>


{% include "partials/contact.njk" %}