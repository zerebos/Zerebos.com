---
layout: base.njk
pagination:
  data: collections.posts
  size: 10
  alias: posts
  reverse: true
---

{% import "blog.njk" as blog %}

<section class="flex column flex-align-center container" id="blog-header">
    <h2>Blog</h2>
    <p>Development insights, tutorials, and thoughts on open source.</p>
    {{ blog.tagCloud(collections, collections.blogTags, tag) }}
</section>

<hr class="flex container medium" />

<section class="flex container column" id="blog-posts">
    {% for post in posts %}
        {{ blog.preview(post) }}
    {% endfor %}

    {% if not posts.length %}
        <div class="no-posts">
            <p>No blog posts yet. Check back soon for development insights and tutorials!</p>
        </div>
    {% endif %}
</section>

{% if pagination.href.previous or pagination.href.next %}
<section class="flex container blog-pagination">
    <div class="flex pagination-nav">
        {% if pagination.href.previous %}
            <a href="{{pagination.href.previous}}" class="btn btn-primary">← Newer Posts</a>
        {% endif %}
        {% if pagination.href.next %}
            <a href="{{pagination.href.next}}" class="btn btn-primary">Older Posts →</a>
        {% endif %}
    </div>
</section>
{% endif %}
