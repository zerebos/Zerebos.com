---
// The blog's RSS feed link for a page header's meta line.
const rssIcon = `<path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle>`;
---

{/* kept on one line, so no whitespace ends up underlined inside the link */}
<a class="feed-link" href="/feed.xml"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={rssIcon} />RSS feed</a>
