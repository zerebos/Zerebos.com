---
import type { MarkdownHeading } from "astro";

interface Props {
  /** Shown above the links and used as the nav's accessible name */
  label: string;
  /** From `render()`. Only the h2s are listed. */
  headings: MarkdownHeading[];
}

const { label, headings } = Astro.props;

// Project READMEs start headings with emoji (`🎮 How to Play`), which only the page body keeps.
const sections = headings
  .filter((heading) => heading.depth === 2)
  .map((heading) => ({
    slug: heading.slug,
    text: heading.text.replace(/^[\p{Extended_Pictographic}\uFE0F\u200D\s]+/u, ""),
  }));
---

{sections.length > 0 && (
  <nav class="flex column post-toc" aria-label={label}>
    <span class="side-label">{label}</span>
    <ol>
      {sections.map((section) => (
        <li><a class="hover-fill" href={`#${section.slug}`}>{section.text}</a></li>
      ))}
    </ol>
  </nav>
)}

<script src="../scripts/contents.ts"></script>
