---
interface Props {
  title: string;
  blurb?: string;
  date?: Date;
  updated?: Date;
  readingTime?: number;
  /** Matches the title to the same name on another page, so the browser morphs one into the other. */
  titleTransitionName?: string;
}

const { title, blurb, date, updated, readingTime, titleTransitionName } = Astro.props;
---

<section class="flex column flex-align-center container" id="page-header">
  {/* Astro makes up a name when `transition:name` is undefined, and that name would match the header on every page. */}
  {titleTransitionName ? <h2 transition:name={titleTransitionName}>{title}</h2> : <h2>{title}</h2>}
  <div class="flex text-muted" id="page-subheader">
    {date && (
      <span>
        Published <time datetime={date.toISOString()}>
          {date.toLocaleDateString("en-US", { dateStyle: "long" })}
        </time>
      </span>
    )}
    {date && updated && <span class="separator">&bull;</span>}
    {updated && (
      <span>
        Updated <time datetime={updated.toISOString()}>
          {updated.toLocaleDateString("en-US", { dateStyle: "long" })}
        </time>
      </span>
    )}
    {date && readingTime && readingTime > 0 && <span class="separator">&bull;</span>}
    {readingTime && readingTime > 0 && (
      <span>
        {readingTime} min read
      </span>
    )}
  </div>
  {blurb && <p>{blurb}</p>}
</section>

<hr class="flex container medium" />
