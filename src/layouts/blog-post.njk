{% extends "./base.njk" %}

{% block content %}
<section class="flex column flex-align-center container" id="projects-header">
    <h2>{{title}}</h2>
    <p>{{description}}</p>
    <p><time datetime="{{date | date}}">{{date | date("en-US", {dateStyle: "long"})}}</time></p>
</section>

<hr class="flex container medium" />

{% if tags %}
<section class="flex column stats-wrap">
    <div class="flex heading">
        <h2>Tags</h2>
    </div>
    <div class="flex stats blog-meta">
        {# <time datetime="{{date | date}}">{{date | date("en-US", {dateStyle: "long"})}}</time> #}

    {# <div class="blog-tags"> #}
        {% for tag in tags %}
            {% if tag != "posts" %}
                <span class="tag">{{tag}}</span>
            {% endif %}
        {% endfor %}
    {# </div> #}

    </div>
</section>
{% endif %}

<section class="flex column container blog-content project-markdown">
    <div class="flex column content">
        {{content | safe}}
    </div>
</section>

<section class="flex column container medium blog-navigation">
    <hr />
    <div class="flex blog-nav-links">
        <a href="/blog" class="btn btn-primary">← Back to Blog</a>
        <div class="flex column blog-share">
            <span>Share this post:</span>
            <div class="flex share-links">
                <a href="https://twitter.com/intent/tweet?url={{page.url | absolute}}&text={{title}}" target="_blank" rel="noreferrer">Twitter</a>
                <a href="https://www.linkedin.com/sharing/share-offsite/?url={{page.url | absolute}}" target="_blank" rel="noreferrer">LinkedIn</a>
            </div>
        </div>
    </div>
</section>

<link href="https://unpkg.com/prismjs@1.20.0/themes/prism-okaidia.css" rel="stylesheet" />
{% endblock %}